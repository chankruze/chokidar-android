<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        android:icon="@drawable/ic_charger_removal"
        android:defaultValue="false"
        android:key="charger_removal_alert_switch"
        android:summary="@string/desc_charger_removal_alert"
        android:title="Enable Charger Removal alert" />

    <ListPreference
        android:icon="@drawable/outline_music_note_24"
        android:key="charger_removal_alert_tone_picker"
        android:title="Charger Removal Alert Tone"
        android:entries="@array/alarm_tone_names"
        android:entryValues="@array/alarm_tone_values"
        android:defaultValue="tone1"
        android:dialogTitle="Select Alert Tone"
        android:summary="%s"/>
</PreferenceScreen>
