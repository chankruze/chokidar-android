<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        android:icon="@drawable/ic_pocket_alarm"
        android:defaultValue="false"
        android:key="pocket_alarm_switch"
        android:summary="Toggle this switch to enable or disable pocket alarm"
        android:title="Enable Pocket Alarm" />

    <ListPreference
        android:icon="@drawable/outline_music_note_24"
        android:key="pocket_alarm_tone_picker"
        android:title="Pocket Alarm Tone"
        android:entries="@array/alarm_tone_names"
        android:entryValues="@array/alarm_tone_values"
        android:defaultValue="tone1"
        android:dialogTitle="Select Alarm Tone"
        android:summary="%s"/>
</PreferenceScreen>
